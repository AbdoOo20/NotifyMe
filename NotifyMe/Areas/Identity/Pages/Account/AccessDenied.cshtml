@page
@model AccessDeniedModel
@{
    Layout = null;
    ViewData["Title"] = "Access Denied";
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access Denied</title>
	<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
	<link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
	<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
	<link rel="icon" href="~/images/logo.png" />
</head>
<body>
    <div class="container d-flex justify-content-center align-items-center min-vh-100">
        <div class="text-center p-5 shadow-lg rounded-4 bg-white" style="max-width: 500px; border-top: 5px solid #622c8e;">
            <div class="mb-4">
                <i class="bi bi-shield-lock-fill text-danger" style="font-size: 6rem;"></i>
            </div>
            <h1 class="fw-bold text-dark">Access Denied</h1>
            <p class="text-muted fs-5">Sorry, you don't have the necessary permissions to view this page.</p>

            <div class="mt-4 d-grid gap-2">
                <a href="/" class="btn btn-dark btn-lg rounded-pill">
                    <i class="bi bi-house-door me-2"></i>Back to Home
                </a>
                <button onclick="history.back()" class="btn btn-outline-secondary rounded-pill">
                    Go Back
                </button>
            </div>

            <p class="mt-4 small text-secondary">If you believe this is an error, please contact your administrator.</p>
        </div>
    </div>
</body>
</html>