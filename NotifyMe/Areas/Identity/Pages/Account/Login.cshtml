@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<link href="~/css/login.css" rel="stylesheet" />

<div class="welcome-text text-center mb-4">
    <h2 class="fw-bold">
        <i class="me-2"></i>Welcome Back
    </h2>
</div>

<div class="container d-flex justify-content-center align-items-center min-vh-150">
    <div class="row w-100">
        <div class="col-lg-5 mx-auto">
            <div class="login-card" style="direction: ltr">
                <div class="card-body">
                    <div class="text-center">
                        <img src="~/images/logo.png" alt="Logo" width="50px" height="50px">
                        <h3 class="text-center mb-4 fw-bold">
                            <i class="me-2"></i>LOGIN
                        </h3>
                    </div>

                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                            <label asp-for="Input.Email" style="text-align: left; right: auto; left: 0;">Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" aria-required="true" />
                            <label asp-for="Input.Password" style="text-align: left; right: auto; left: 0;">Password</label>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label class="form-check-label" asp-for="Input.RememberMe">
                                <i class="me-1"></i>Remember Me
                            </label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2">
                            <i class="me-1"></i>Login
                        </button>

                        <div class="text-center pt-4">
                            <a class="fs-5" asp-area="Identity" asp-page="/Account/Register"> Don't have account ? register now </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
