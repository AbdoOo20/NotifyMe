@model IEnumerable<NotifyMe.Core.Models.CustomerViewModel>

@{
	ViewData["Title"] = "Customers";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex bg-white rounded-top-3 px-4 py-2 justify-content-between align-items-center flex-wrap">
	<h1 class="head-color my-4">Customers</h1>

	<div class="d-flex align-items-center my-2 col-12 col-md-8 justify-content-md-end">
		<div class="input-group me-2 flex-grow-1" style="max-width: 300px;">
			<span class="input-group-text rounded-start-3 rounded-end-0" style="background-color: #D9D9D9A8">
				<img class="rounded-2 mx-1" width="20px" height="20px" src="~/images/search.png" alt="Search Image" />
			</span>
			<input type="text" id="searchTable" class="form-control rounded-start-0 rounded-end-3" placeholder="Search about customer..." />
		</div>
	</div>
</div>


<div class="table-responsive">
	<table class="table border-custom" id="table">
		<thead>
			<tr>
				<th>
					@Html.DisplayNameFor(model => model.Email)
				</th>
				<th class="text-center">
					@Html.DisplayNameFor(model => model.Phone)
				</th>
				<th class="text-center">
					@Html.DisplayNameFor(model => model.Plan)
				</th>
				<th class="text-center">
					@Html.DisplayNameFor(model => model.IsActive)
				</th>
				<th class="text-center">
					Actions
				</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>
						@if (item.IsLogin)
						{
							<div class="d-inline-flex align-items-center gap-2">
								<span class="p-1 bg-success border border-light rounded-circle" style="width: 10px; height: 10px;"></span>
							</div>
						}
						else
						{
							<div class="d-inline-flex align-items-center gap-2">
								<span class="p-1 bg-danger border border-light rounded-circle" style="width: 10px; height: 10px;"></span>
							</div>
						}
						@Html.DisplayFor(modelItem => item.Email)
					</td>
					<td class="text-center">
						@Html.DisplayFor(modelItem => item.Phone)
					</td>
					<td class="text-center">
						@Html.DisplayFor(modelItem => item.Plan)
					</td>
					<td class="text-center">
						@if (item.IsActive)
						{
							<span class="fw-bold" style="color:green;">Active</span>
						}
						else
						{
							<span class="fw-bold" style="color:red;">Inactive</span>
						}
					</td>
					<td class="text-center">
						@if (!item.IsActive)
						{
							<a asp-action="Activate" asp-route-id="@item.Id" class="me-2" title="UnLock">
								<span class="svg-icon" style="--icon-url: url('/images/lock.png');"></span>
							</a>
						}
						else
						{
							<a asp-action="Activate" asp-route-id="@item.Id" class="me-2" title="Lock">
								<span class="svg-icon" style="--icon-url: url('/images/unlock.png');"></span>
							</a>
						}
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>

@section Scripts {
	<script src="~/js/datatable.js"></script>
}