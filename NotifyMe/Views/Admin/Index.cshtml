@model NotifyMe.Core.Models.AdminStatisticsViewModel
@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4 px-4">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <h2 class="fw-bold text-dark">Welcome To Admin Dashboard</h2>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm p-3 h-100 text-white" style="background: linear-gradient(45deg, #2193b0, #6dd5ed);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-0 opacity-75">Customers</p>
                        <h2 class="mb-0 fw-bold">@Model.CustomerCount</h2>
                    </div>
                    <i class="bi bi-people-fill fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm p-3 h-100 text-white" style="background: linear-gradient(45deg, #00b09b, #96c93d);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-0 opacity-75">Active Monitors</p>
                        <h2 class="mb-0 fw-bold">@Model.ActiveMonitorCount</h2>
                    </div>
                    <i class="bi bi-display-fill fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm p-3 h-100 text-white" style="background: linear-gradient(45deg, #11998e, #38ef7d);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-0 opacity-75">InActive Monitor</p>
                        <h2 class="mb-0 fw-bold">@Model.InActiveMonitorCount</h2>
                    </div>
                    <i class="bi bi-patch-check-fill fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm p-3 h-100 text-white" style="background: linear-gradient(45deg, #373331, #4b4453);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-0 opacity-75">Total Revenue</p>
                        <h2 class="mb-0 fw-bold">$@Model.TotalRevenue</h2>
                    </div>
                    <i class="bi bi-cash-coin fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-4 col-lg-5">
            <div class="card border-0 shadow-sm p-4 h-100">
                <h5 class="fw-bold mb-4 border-bottom pb-2">Status Breakdown</h5>
                <div class="list-group list-group-flush">
                    <div class="list-group-item d-flex justify-content-between align-items-center border-0 px-0">
                        <span><i class="bi bi-gift me-2 text-primary"></i> Free Packages</span>
                        <span class="badge bg-primary rounded-pill">@Model.ActiveFreePackage</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center border-0 px-0">
                        <span><i class="bi bi-clock-history me-2 text-warning"></i> Pending</span>
                        <span class="badge bg-warning text-dark rounded-pill">@Model.PendingSubs</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center border-0 px-0">
                        <span><i class="bi bi-exclamation-triangle me-2 text-danger"></i> Expired</span>
                        <span class="badge bg-danger rounded-pill">@Model.ExpiredSubs</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center border-0 px-0">
                        <span><i class="bi bi-x-circle me-2 text-secondary"></i> Cancelled</span>
                        <span class="badge bg-secondary rounded-pill">@Model.CancelledSubs</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center border-0 px-0">
                        <span><i class="bi bi-check-circle-fill me-2 text-success"></i> Active </span>
                        <span class="badge bg-success rounded-pill">@Model.ActiveSubs</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-8 col-lg-7">
            <div class="card border-0 shadow-sm p-4 h-100">
                <h5 class="fw-bold mb-4">Subscription Analytics</h5>
                <div style="min-height: 350px;">
                    <div class="chart-container" style="position: relative; height:350px;">
                        <canvas id="subscriptionChart"
                                data-active="@Model.ActiveSubs"
                                data-free="@Model.ActiveFreePackage"
                                data-pending="@Model.PendingSubs"
                                data-expired="@Model.ExpiredSubs"
                                data-cancelled="@Model.CancelledSubs">
                        </canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/adminHome.js" asp-append-version="true"></script>
}