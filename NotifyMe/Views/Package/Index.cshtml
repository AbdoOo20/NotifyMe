@model NotifyMe.Core.Models.ShowSubscriptionViewModel
@using NotifyMe.Core.Enums
@{
    ViewData["Title"] = "Packages";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/package.css" asp-append-version="true" />
}

<div>
    <div class="pricing-header">
        <h1 class="display-4 fw-bold">Ready to start monitoring ?</h1>
        <p class="lead text-muted">Choose the perfect plan to stay updated with real-time notifications.</p>

        <div class="d-flex justify-content-center align-items-center mt-2">
            <span class="me-3 fw-bold text-secondary">Monthly</span>
            <div class="form-check form-switch fs-3">
                <input class="form-check-input" type="checkbox" id="billingToggle" role="switch" @(Model.Type == SubscriptionDuration.Year ? "checked" : "")>
            </div>
            <span class="ms-3 fw-bold">Yearly <span class="badge bg-success ms-1 rounded-pill" style="font-size: 0.9rem;">Save 20%</span></span>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4 justify-content-center">

        <div class="col">
            <div class="card h-100 p-4 @(Model.CurrentPackage == PackageType.Free ? "current-plan-card" : "")">
                @if (Model.CurrentPackage == PackageType.Free)
                {
                    <div class="current-plan-badge">Current Plan</div>
                }
                <div class="card-body">
                    <h5 class="text-uppercase text-muted fw-bold">Free</h5>
                    <div class="price-box my-3">
                        <span class="price-value">$0</span>
                        <span class="price-duration">/ Forever</span>
                    </div>
                    <p class="text-muted small">Perfect for students and casual tracking.</p>
                    <hr>
                    <ul class="feature-list">
                        <li><i class="fas fa-check-circle"></i> Max 3 Monitors</li>
                        <li><i class="fas fa-check-circle"></i> 45–60 min Check Interval</li>
                        <li><i class="fas fa-check-circle"></i> Email Notifications</li>
                        <li><i class="fas fa-check-circle"></i> 7 Days Alert History</li>
                        <li class="disabled"><i class="fas fa-times-circle"></i> Telegram & Webhooks</li>
                    </ul>
                    @if (Model.CurrentPackage == PackageType.Free)
                    {
                        <button class="btn btn-primary btn-lg w-100 mt-3 rounded-pill disabled">Current Plan</button>
                    }
                    else
                    {
                        <button onclick="upgradePlan(@((int)PackageType.Free))" class="btn btn-outline-primary btn-lg w-100 mt-3 rounded-pill">Upgrade</button>
                    }
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 p-4 @(Model.CurrentPackage == PackageType.Pro ? "current-plan-card" : "")">
                @if (Model.CurrentPackage == PackageType.Pro)
                {
                    <div class="current-plan-badge">Current Plan</div>
                }
                else
                {
                    <span class="badge-popular">Most Popular</span>
                }
                <div class="card-body">
                    <h5 class="text-uppercase text-primary fw-bold">Pro</h5>
                    <div class="price-box my-3">
                        <span class="price-value" id="pro-price">$8</span>
                        <span class="price-duration">/ <span class="period">month</span></span>
                    </div>
                    <p class="text-muted small">Ideal for individuals and small teams.</p>
                    <hr>
                    <ul class="feature-list">
                        <li><i class="fas fa-check-circle"></i> <strong>30 Monitors</strong></li>
                        <li><i class="fas fa-bolt text-warning"></i> 10-30 min Check Interval</li>
                        <li><i class="fas fa-check-circle"></i> Email + Telegram Alerts</li>
                        <li><i class="fas fa-check-circle"></i> 30 Days Alert History</li>
                        <li><i class="fas fa-check-circle"></i> Advanced Retry Logic</li>
                    </ul>
                    @if (Model.CurrentPackage == PackageType.Pro)
                    {
                        <button class="btn btn-primary btn-lg w-100 mt-3 rounded-pill disabled">Current Plan</button>
                    }
                    else
                    {
                        <button onclick="upgradePlan(@((int)PackageType.Pro))" class="btn btn-outline-primary btn-lg w-100 mt-3 rounded-pill shadow-sm">Upgrade</button>
                    }
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 p-4 @(Model.CurrentPackage == PackageType.Business ? "current-plan-card" : "")">
                @if (Model.CurrentPackage == PackageType.Business)
                {
                    <div class="current-plan-badge">Current Plan</div>
                }
                <div class="card-body">
                    <h5 class="text-uppercase text-muted fw-bold">Business</h5>
                    <div class="price-box my-3">
                        <span class="price-value" id="biz-price">$25</span>
                        <span class="price-duration">/ <span class="period">month</span></span>
                    </div>
                    <p class="text-muted small">For power users and scaling businesses.</p>
                    <hr>
                    <ul class="feature-list">
                        <li><i class="fas fa-check-circle"></i> <strong>200 Monitors</strong></li>
                        <li><i class="fas fa-bolt text-warning"></i> 1-10 min Check Interval</li>
                        <li><i class="fas fa-check-circle"></i> Email + Telegram + Webhook</li>
                        <li><i class="fas fa-check-circle"></i> 90 Days Alert History</li>
                        <li><i class="fas fa-check-circle"></i> Priority Support & Logs</li>
                    </ul>
                    @if (Model.CurrentPackage == PackageType.Business)
                    {
                        <button class="btn btn-primary btn-lg w-100 mt-3 rounded-pill disabled">Current Plan</button>
                    }
                    else
                    {
                        <button onclick="upgradePlan(@((int)PackageType.Business))" class="btn btn-outline-primary btn-lg w-100 mt-3 rounded-pill">Upgrade</button>
                    }
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/package.js" asp-append-version="true"></script>
}