@model NotifyMe.Core.Models.CustomerViewModel

@{
	ViewData["Title"] = "Alerts";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    html {
        scroll-behavior: smooth;
    }
</style>

<div class="container mt-5">
    <h2>Profile</h2>
    <hr />
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">Email Address</label>
                <p class="form-control-plaintext border-bottom">@Model.Email</p>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Phone</label>
                <p class="form-control-plaintext border-bottom">@Model.Phone</p>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">Current Plan</label>
                <p class="form-control-plaintext border-bottom">@Model.Plan</p>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Status</label>
                <p class="form-control-plaintext">
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                        @(Model.IsActive ? "Active" : "Inactive")
                    </span>
                </p>
            </div>
        </div>

        <h4 class="mt-4 text-dark">Notification Settings</h4>
        <div class="card p-3 shadow-sm">
            <div class="mb-3">
                <label asp-for="NotificationEmail" class="form-label">Notification Email</label>
                <input asp-for="NotificationEmail" class="form-control" placeholder="Enter email for alerts" />
                <span asp-validation-for="NotificationEmail" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TelegramChatId" class="form-label d-flex">
                    Telegram Chat ID
                    <a href="#telegram-help" class="text-decoration-none small text-primary mx-2">
                        <i class="bi bi-question-circle"></i> How to get it ?
                    </a>
                </label>
                <input asp-for="TelegramChatId" class="form-control" type="number" placeholder="Enter your Telegram Chat ID (Numeric)" />
            </div>

            <div class="mb-3">
                <label asp-for="Webhook" class="form-label">Webhook URL</label>
                <input asp-for="Webhook" class="form-control" type="url" placeholder="Enter Webhook URL" />
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success btn-lg">Update</button>
        </div>
    </form>
    <hr class="mt-5" />

    <div id="telegram-help" class="card bg-light p-4 mb-5 border-0 shadow-sm">
        <h5 class="text-primary mb-3">
            <i class="bi bi-info-circle-fill"></i> How to get your Telegram Chat ID
        </h5>
        <ol class="mb-0">
            <li class="mb-2">Search for <strong>@@myidbot</strong> on Telegram.</li>
            <li class="mb-2">Press <strong>Start</strong> or send a message to the bot.</li>
            <li class="mb-2">The bot will reply with your <strong>ID</strong> (a numeric value like <code>123456789</code>).</li>
            <li>Copy that number and paste it in the <strong>Telegram Chat ID</strong> field above.</li>
        </ol>
    </div>
</div>