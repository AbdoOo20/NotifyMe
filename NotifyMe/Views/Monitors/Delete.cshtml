@model NotifyMe.Core.Models.MonitorViewModel

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="head-color">Delete</h1>

<h3>Are you sure you want to delete this?</h3>

<div>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.URL)
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.URL)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CheckIntervalMinutes)
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.CheckIntervalMinutes)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CreateAt)
        </dt>
        <dd class = "col-sm-9">
            @Html.DisplayFor(model => model.CreateAt)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-success" />
        <a class="btn btn-danger" asp-action="Index">Back</a>
    </form>
</div>
