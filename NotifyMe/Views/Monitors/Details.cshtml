@model IEnumerable<NotifyMe.Core.Models.MonitorErrorViewModel>

@{
    ViewData["Title"] = "Monitor Errors";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/monitorError.css" asp-append-version="true" />
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="head-color"><i class="bi bi-bug-fill text-danger me-2"></i>Monitor Errors</h2>
        <a asp-action="All" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <h5 class="card-title mb-0 fw-bold text-danger">
                <i class="bi bi-clock-history me-2"></i>Error History
            </h5>
            <span class="badge bg-danger rounded-pill px-3">@Model.Count() Errors</span>
        </div>

        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive" style="max-height: 70vh;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light sticky-top">
                            <tr>
                                <th class="ps-4" style="width: 150px;">Date & Time</th>
                                <th style="width: 100px;">Error Type</th>
                                <th style="width: 200px;">Error Message</th>
                                <th>Details</th>
                                <th class="text-center" style="width: 100px;">Stack</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var error in Model.OrderByDescending(e => e.CreateAt))
                            {
                                var collapseId = "trace_" + error.Id;
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@error.CreateAt.ToString("MMM dd, yyyy")</div>
                                        <div class="text-muted small">@error.CreateAt.ToString("HH:mm:ss")</div>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold text-wrap">@error.Type</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-danger-subtle text-danger mb-1">Critical Error</span>
                                        <div class="small fw-semibold text-wrap">@error.Message</div>
                                    </td>
                                    <td>
                                        <div class="text-secondary small text-truncate" style="max-width: 400px;" title="@error.StackTrace">
                                            @error.StackTrace
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-light border" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#@collapseId">
                                            <i class="bi bi-chevron-down"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr class="collapse bg-light-subtle" id="@collapseId">
                                    <td colspan="4" class="p-4">
                                        <div class="p-3 bg-dark text-light rounded-3 shadow-inner">
                                            <h6 class="text-warning border-bottom border-secondary pb-2 mb-3">Full Stack Trace</h6>
                                            <pre class="small mb-0" style="white-space: pre-wrap; word-break: break-all; font-family: 'Courier New', Courier, monospace;">@error.StackTrace</pre>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-shield-check text-success" style="font-size: 4rem;"></i>
                    <p class="mt-3 text-muted fs-5">Everything is running smoothly. No errors found!</p>
                </div>
            }
        </div>
    </div>
</div>