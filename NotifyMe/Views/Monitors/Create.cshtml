@model NotifyMe.Core.Models.AddMonitorViewModel

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/monitor.css" asp-append-version="true" />
}

<h1 class="head-color">Create Monitor</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Url" class="control-label"></label>
                <input asp-for="Url" class="form-control" />
                <span asp-validation-for="Url" class="text-danger"></span>
            </div>
            <div class="form-group mt-2">
                <div class="d-flex justify-content-between align-items-center">
                    <label asp-for="CssSelector" class="control-label">
                        CSS Selector <span class="text-muted small fw-normal"> (Optional)</span>
                    </label>
                    <a href="#css-help-section" class="text-decoration-none small">
                        <i class="bi bi-question-circle"></i> How to get it?
                    </a>
                </div>

                <textarea asp-for="CssSelector" class="form-control" rows="2" style="resize: none"></textarea>

                <span asp-validation-for="CssSelector" class="text-danger small"></span>
            </div>
            <div class="form-group mt-2">
                <label asp-for="CheckIntervalMinutes" class="control-label"></label>
                <select asp-for="CheckIntervalMinutes" class="form-control" asp-items="ViewBag.IntervalMinutes">
                    <option selected hidden value="">Select Interval Minute</option>
                </select>
                <span asp-validation-for="CheckIntervalMinutes" class="text-danger"></span>
            </div>
            <div class="form-group mt-2">
                <label asp-for="NotificationChannel" class="control-label"></label>
                <select asp-for="NotificationChannel" class="form-control" asp-items="ViewBag.NotificationChannel">
                    <option selected hidden value="">Select Notification Channel</option>
                </select>
                <span asp-validation-for="NotificationChannel" class="text-danger"></span>
            </div>
            <div class="d-inline-flex align-items-stretch gap-2 mt-2">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a class="btn btn-danger d-flex align-items-center" asp-action="Index">Back</a>
            </div>
        </form>
    </div>
    <div id="css-help-section" class="card border-0 shadow-sm mt-5 bg-light">
        <div class="card-body p-4">
            <h6 class="text-primary fw-bold mb-3 d-flex align-items-center">
                <i class="bi bi-info-circle-fill me-2 fs-5"></i> How to get your CSS Selector
            </h6>

            <div class="ps-2">
                <p class="small text-secondary mb-3">Follow these steps using Google Chrome or Edge browser:</p>

                <ol class="small text-dark mb-0">
                    <li class="mb-2">Go to the website you want to monitor.</li>
                    <li class="mb-2"><strong>Right-click</strong> on the specific text or element (e.g., price, stock status).</li>
                    <li class="mb-2">Select <strong>"Inspect"</strong> from the menu. The developer console will open.</li>
                    <li class="mb-2">The element's HTML code will be highlighted. <strong>Right-click</strong> on that highlighted code.</li>
                    <li class="mb-2">Choose <strong>Copy</strong> &rarr; <strong>Copy selector</strong>.</li>
                    <li>Paste the copied text into the <strong>CSS Selector</strong> field above.</li>
                    <li class="mb-2">
                        <strong>Make sure</strong> the CSS Selector looks similar to these examples:
                        <div class="mt-2 p-2 bg-dark text-warning rounded-2 font-monospace shadow-sm" style="font-size: 12px;">
                            #price-item > div.current-price <br />
                            .product-detail-info .stock-status <br />
                            body > main > div > span
                        </div>
                    </li>
                </ol>
            </div>

            <div class="mt-3 p-2 bg-white rounded border border-info-subtle shadow-sm">
                <small class="text-muted">
                    <i class="bi bi-lightbulb text-warning me-1"></i>
                    <strong>Tip:</strong> Using a specific selector ensures you only get notified when <strong>that specific part</strong> of the page changes.
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

